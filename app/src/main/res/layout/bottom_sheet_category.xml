<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/background_bottom_sheet"
    android:paddingTop="12dp" android:paddingBottom="20dp">
    <View android:layout_width="36dp" android:layout_height="4dp"
        android:layout_gravity="center_horizontal" android:background="@color/plango_card_stroke" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="20dp" android:text="@string/category_sheet_title"
        android:textColor="@color/plango_text" android:textSize="22sp" android:textStyle="bold" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/listCategories"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:maxHeight="420dp" android:nestedScrollingEnabled="true" />
</LinearLayout>
